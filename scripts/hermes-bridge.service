[Unit]
Description=Hermes HTTP bridge for Control A
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/hermes-bridge
Environment=PORT=7771
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /root/hermes-bridge/server.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/hermes-bridge.log
StandardError=append:/var/log/hermes-bridge.log

[Install]
WantedBy=multi-user.target
