# Supabase (auth + DB)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LLM backend (Hermes USA preferred; Anthropic as fallback)
HERMES_USA_URL=http://YOUR_HOST:8000
HERMES_USA_TOKEN=

# Direct Anthropic fallback (used if HERMES_USA_URL is empty)
ANTHROPIC_API_KEY=

# Demo mode: when true, uses mock data instead of DB. Useful before Supabase is wired.
NEXT_PUBLIC_DEMO_MODE=true
